<UserControl x:Class="FaultTolerance.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FaultTolerance.Models">

    <!-- DataContext = page view model: inputs + expected output of the first test -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSubtle}"
            BorderThickness="1,0,0,0">
        <StackPanel Margin="24">
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Set the input values and the output you expect from the circuit."
                       Style="{StaticResource HintTextStyle}" Margin="0,6,0,20"/>

            <TextBlock Text="INPUTS" Style="{StaticResource GroupTitleStyle}"/>
            <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,10,0,0" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}">
                                <Run Text="Input "/><Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Static models:BitOptions.Values}"
                                      SelectedItem="{Binding Value, Mode=TwoWay}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="{StaticResource BorderBrushSubtle}" Margin="0,8,0,18"/>

            <TextBlock Text="EXPECTED OUTPUT" Style="{StaticResource GroupTitleStyle}"/>
            <Grid Margin="0,10,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Expected output" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{x:Static models:BitOptions.Values}"
                          SelectedItem="{Binding ExpectedOutput, Mode=TwoWay}"/>
            </Grid>

            <Button Content="{Binding ActionLabel}"
                    Command="{Binding EvaluateCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Border>
</UserControl>
