<UserControl x:Class="FaultTolerance.Views.DiagnosticBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FaultTolerance.Models">

    <!--
        Stand-alone diagnostic box. DataContext = DiagnosticViewModel.
        Put it anywhere (below the circuit, or in place of the right-hand settings panel):
            <views:DiagnosticBox DataContext="{Binding Diagnostic}"/>
        Labels:  Title (Test #n) | Instruction | RequiredInputs (inputs to apply) | Status
        Input:   MeasuredOutput + "Submit result" button
    -->
    <Border Style="{StaticResource CardStyle}"
            Padding="20,16"
            Margin="0,12,0,0"
            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- What the user has to do -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding Instruction}" Style="{StaticResource HintTextStyle}" Margin="0,2,0,10"/>

                <ItemsControl ItemsSource="{Binding RequiredInputs}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BadgeBorderStyle}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="=" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Status}" Style="{StaticResource HintTextStyle}"
                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Where the user gives the result back -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="MEASURED OUTPUT" Style="{StaticResource GroupTitleStyle}"/>
                <ComboBox Margin="0,8,0,12"
                          ItemsSource="{x:Static models:BitOptions.Values}"
                          SelectedItem="{Binding MeasuredOutput, Mode=TwoWay}"/>
                <Button Content="Submit result"
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
