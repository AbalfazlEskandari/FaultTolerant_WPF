<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FaultTolerance.ViewModels"
                    xmlns:views="clr-namespace:FaultTolerance.Views">

    <!-- View model -> view mapping used by the navigation ContentControl -->
    <DataTemplate DataType="{x:Type vm:Page1ViewModel}">
        <views:Page1View/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:Page2ViewModel}">
        <views:Page2View/>
    </DataTemplate>

    <!-- Read-only input badge drawn next to the circuit -->
    <DataTemplate x:Key="InputBadgeTemplate" DataType="{x:Type vm:InputViewModel}">
        <Border Width="80" Height="30" Style="{StaticResource BadgeBorderStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Output badge; the content is the display string ("?", "0" or "1") -->
    <DataTemplate x:Key="OutputBadgeTemplate">
        <Border Width="80" Height="30" Style="{StaticResource BadgeBorderStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Out" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
