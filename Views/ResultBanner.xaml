<UserControl x:Class="FaultTolerance.Views.ResultBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext = page view model. Hidden until an evaluation has run. -->
    <Border CornerRadius="10" BorderThickness="1" Padding="20,12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Correct">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Wrong">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Background" Value="{StaticResource DangerBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="{Binding ResultMessage}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding ResultDetail}" FontSize="13" Margin="0,2,0,0" Opacity="0.85"/>
        </StackPanel>
    </Border>
</UserControl>
