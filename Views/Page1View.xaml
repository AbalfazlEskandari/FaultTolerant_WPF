<UserControl x:Class="FaultTolerance.Views.Page1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FaultTolerance.Views">

    <!-- DataContext = Page1ViewModel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,16">
                <Viewbox Stretch="Uniform" Margin="28">
                    <!-- Natural size 420 x 140; the Viewbox scales the whole drawing, wires included. -->
                    <Canvas Width="420" Height="140">

                        <!-- Wires -->
                        <Line Style="{StaticResource WireLineStyle}" X1="80" Y1="50" X2="170" Y2="50"/>
                        <Line Style="{StaticResource WireLineStyle}" X1="80" Y1="90" X2="170" Y2="90"/>
                        <Line Style="{StaticResource WireLineStyle}" X1="290" Y1="70" X2="340" Y2="70"/>

                        <!-- Fixed OR gate -->
                        <views:GateControl Canvas.Left="170" Canvas.Top="30" DataContext="{Binding Gate}"/>

                        <!-- Input badges (values are edited in the settings panel) -->
                        <ContentControl Canvas.Left="0" Canvas.Top="35"
                                        Content="{Binding Inputs[0]}"
                                        ContentTemplate="{StaticResource InputBadgeTemplate}"/>
                        <ContentControl Canvas.Left="0" Canvas.Top="75"
                                        Content="{Binding Inputs[1]}"
                                        ContentTemplate="{StaticResource InputBadgeTemplate}"/>

                        <!-- Output badge -->
                        <ContentControl Canvas.Left="340" Canvas.Top="55"
                                        Content="{Binding OutputDisplay}"
                                        ContentTemplate="{StaticResource OutputBadgeTemplate}"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Row="2">
                <views:ResultBanner/>
                <views:DiagnosticBox DataContext="{Binding Diagnostic}"/>
            </StackPanel>
        </Grid>

        <views:SettingsPanel Grid.Column="1"/>
    </Grid>
</UserControl>
