<Window x:Class="FaultTolerance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fault Tolerance"
        Width="1240" Height="800"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- The root grid fills the whole client area: no outer box, no outer margin. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,16">

                <!-- Author -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Abalfazl Eskandari" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="aeskandari.ir" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel>
                    <Button Content="Page 1 - OR Gate Test"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowPage1Command}"
                            Tag="{Binding IsPage1Selected}"/>
                    <Button Content="Page 2 - Circuit Diagnosis"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowPage2Command}"
                            Tag="{Binding IsPage2Selected}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Current page; the view is chosen by the DataTemplates in Styles/Templates.xaml -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" IsTabStop="False"/>
    </Grid>
</Window>
