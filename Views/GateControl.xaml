<UserControl x:Class="FaultTolerance.Views.GateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FaultTolerance.Models"
             Width="120" Height="80">

    <!--
        A logic gate drawn with Path geometry in a 120 x 80 box (DataContext = GateViewModel).
        Input pins: (0,20) and (0,60). Output pin: (120,40).
        Clicking the gate body opens a Popup with the four gate types.
    -->
    <UserControl.Resources>
        <Style x:Key="GateBodyStyle" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource GateFillBrush}"/>
            <Setter Property="Stroke" Value="{StaticResource GateStrokeBrush}"/>
            <Setter Property="StrokeThickness" Value="2.5"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInteractive}" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsInteractive}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Canvas Width="120" Height="80">

        <!-- Input leads (hidden under the opaque body where they overlap) -->
        <Path Data="M 0,20 L 14,20 M 0,60 L 14,60"
              Stroke="{StaticResource GateStrokeBrush}" StrokeThickness="2.5" IsHitTestVisible="False"/>

        <!-- Output lead (the inversion bubble covers part of it for NAND / NOR) -->
        <Line X1="85" Y1="40" X2="120" Y2="40"
              Stroke="{StaticResource GateStrokeBrush}" StrokeThickness="2.5" IsHitTestVisible="False"/>

        <!-- AND / NAND body: flat back, round front. The click is bound on the shape itself,
             so the Popup below never triggers it. -->
        <Path Style="{StaticResource GateBodyStyle}"
              Data="M 0,0 L 45,0 A 40,40 0 0 1 45,80 L 0,80 Z"
              Visibility="{Binding IsOrShape, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <Path.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding OpenPickerCommand}"/>
            </Path.InputBindings>
        </Path>

        <!-- OR / NOR body: concave back, pointed front -->
        <Path Style="{StaticResource GateBodyStyle}"
              Data="M 0,0 C 30,0 65,5 85,40 C 65,75 30,80 0,80 C 18,55 18,25 0,0 Z"
              Visibility="{Binding IsOrShape, Converter={StaticResource BoolToVisibility}}">
            <Path.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding OpenPickerCommand}"/>
            </Path.InputBindings>
        </Path>

        <!-- Inversion bubble for NAND / NOR -->
        <Ellipse Canvas.Left="85" Canvas.Top="35" Width="10" Height="10"
                 Fill="{StaticResource GateFillBrush}"
                 Stroke="{StaticResource GateStrokeBrush}" StrokeThickness="2.5"
                 IsHitTestVisible="False"
                 Visibility="{Binding IsInverted, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Gate type label -->
        <TextBlock Canvas.Left="8" Canvas.Top="31" Width="64"
                   TextAlignment="Center" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMutedBrush}"
                   IsHitTestVisible="False"
                   Text="{Binding Label}"/>

        <!-- Gate type chooser box -->
        <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
               StaysOpen="False"
               Placement="Bottom"
               VerticalOffset="8"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="GATE TYPE" Style="{StaticResource GroupTitleStyle}" Margin="4,0,0,6"/>
                    <UniformGrid Columns="2">
                        <Button Content="AND" Style="{StaticResource GateOptionButtonStyle}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="{x:Static models:GateType.AND}"/>
                        <Button Content="OR" Style="{StaticResource GateOptionButtonStyle}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="{x:Static models:GateType.OR}"/>
                        <Button Content="NAND" Style="{StaticResource GateOptionButtonStyle}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="{x:Static models:GateType.NAND}"/>
                        <Button Content="NOR" Style="{StaticResource GateOptionButtonStyle}"
                                Command="{Binding SelectTypeCommand}"
                                CommandParameter="{x:Static models:GateType.NOR}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
    </Canvas>
</UserControl>
